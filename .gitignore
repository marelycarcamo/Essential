# Entorno virtual
venv/
.venv/
env/

# Variables de entorno (secretos, nunca se sube)
.env

# Cachés y compilados de Python
__pycache__/
*.py[cod]
*.egg-info/

# Archivos del sistema operativo y del editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log

# Salida del agente: materiales que genera y guarda con aprobación humana
material_generado/

# Vector store: contenido generado y reconstruible corriendo indexar_corpus.py.
# Se versiona el script que lo construye, no el índice (binarios que crecen y
# cambian con cada consulta).
vectorstore/

# Checkpoints durables del grafo de supervisión: estado de ejecución, no código.
# Se regeneran solos; se versiona el grafo que los produce.
checkpoints.db
