# Copia este archivo como ".env" y completa los valores reales ahí.
# El archivo ".env" nunca se sube al repositorio (ya está excluido en .gitignore).
#
# El proyecto tiene tres proveedores y no necesitas los tres: configura los que
# vayas a usar. main.py y el script de consistencia usan OpenRouter; el cliente
# modular (src/cliente.py) usa DeepSeek y deja Gemini como respaldo.

# --- OpenRouter: lo usan main.py y prompts/test_consistencia.py ---
OPENROUTER_API_KEY=tu_clave_de_openrouter
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# --- DeepSeek: proveedor principal del cliente modular ---
DEEPSEEK_API_KEY=tu_clave_de_deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Gemini: proveedor de respaldo del cliente modular ---
# El nombre del modelo tiene que existir en el catálogo de la API; si no,
# la llamada devuelve HTTP 404.
GEMINI_API_KEY=tu_clave_de_gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
